NODE_ENV=local
BATCH_VALUATION_MAX_ITEMS=100
PORT=3000

# CORS (frontend local)
CORS_ORIGINS=http://localhost:5173

# Database
# Host tests (npm test / npm run test:e2e on machine): DB_HOST=localhost
# Docker Compose app service overrides DB_HOST=mysql automatically
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=gai
DB_PASSWORD=gai
DB_DATABASE=gai
DB_LOGGING=false

# Auth
SESSION_TTL_HOURS=8
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
PASSWORD_RESET_TTL_HOURS=1

# AWS SES (production)
AWS_REGION=us-east-1
SES_FROM_EMAIL=noreply@example.com
USE_MOCK_EMAIL=true

# Inventory item images storage
INVENTORY_ITEM_IMAGE_STORAGE_PROVIDER=s3
INVENTORY_ITEM_IMAGE_STORAGE_BUCKET=gai-local
INVENTORY_ITEM_IMAGE_MAX_SIZE_BYTES=10485760
INVENTORY_ITEM_IMAGE_MAX_PER_ITEM=3
INVENTORY_ITEM_IMAGE_PRESIGNED_URL_TTL_SECONDS=300
STORAGE_PROVIDER=s3
STORAGE_BUCKET=gai-local
STORAGE_PRESIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_SIZE_BYTES=52428800
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/jpg,image/png,image/webp,application/pdf,application/json,text/plain,text/csv,application/zip,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
STORAGE_FORCE_PATH_STYLE=false
# AWS uses its default credential chain (ECS task role in production).
# For an isolated local S3-compatible service only, set its loopback endpoint
# and dedicated AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY. Enable versioning.
STORAGE_ENDPOINT_URL=

# Seed
SEED_ADMIN_LOGIN=platform.admin
SEED_ADMIN_EMAIL=admin@gai.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ORG_CNPJ=11222333000181
SEED_ORG_LEGAL_NAME=GAI Test Organization
SEED_TEST_USER_LOGIN=test.user
SEED_TEST_USER_EMAIL=test@gai.local
SEED_TEST_USER_PASSWORD=Test@123456
# Document artifacts are private, versioned BLOBs in the application database.
# Production fails closed unless this delivery mode is explicitly homologated.
DOCUMENT_STORAGE=database
